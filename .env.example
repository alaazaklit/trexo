APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

GOOGLE_MAPS_KEY=
MAPBOX_ACCESS_TOKEN=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# UnlimitedMessaging WhatsApp API - used to deliver OTP codes for phone
# login/signup. Unofficial WhatsApp automation (QR-linked number), no Meta
# Business verification or templates required.
UNLIMITED_MESSAGING_API_URL=https://api.unlimitedmessaging.app
UNLIMITED_MESSAGING_API_TOKEN=

# WhatsApp OTP anti-abuse / anti-restriction settings (config/otp.php,
# App\Services\OtpService) — every value below is optional, defaults shown.
#
# OTP_PROVIDER_MODE controls whether OTP sends actually hit the real
# WhatsApp provider. Leave unset: testing is ALWAYS mocked (hard-coded,
# cannot be overridden), production defaults to live, and local/staging
# default to mock. Only set this to "live" here if you specifically want
# THIS machine to fire real WhatsApp messages — never do that just to make
# local testing "more realistic".
# OTP_PROVIDER_MODE=mock
# OTP_EXPIRATION_MINUTES=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# MAX_OTP_PER_PHONE_10_MINUTES=3
# MAX_OTP_PER_PHONE_PER_DAY=5
# MAX_OTP_PER_IP_PER_HOUR=15
# MAX_OTP_PER_DEVICE_PER_HOUR=15
# MAX_OTP_DISTINCT_PHONES_PER_IP_PER_HOUR=8
# MAX_OTP_DISTINCT_PHONES_PER_DEVICE_PER_HOUR=5
# Global outbound-send throttle, shared by every phone number — ramps from
# INITIAL_GLOBAL_OTP_RATE up to MAX_GLOBAL_OTP_RATE (per minute) in steps of
# INITIAL_GLOBAL_OTP_RATE, once every OTP_RATE_INCREASE_INTERVAL hours, so a
# brand new WhatsApp number can warm up gradually instead of opening at full
# volume. GLOBAL_OTP_BURST_LIMIT caps sends in any 10-second slice.
# INITIAL_GLOBAL_OTP_RATE=20
# MAX_GLOBAL_OTP_RATE=120
# OTP_RATE_INCREASE_INTERVAL=24
# GLOBAL_OTP_BURST_LIMIT=10

# Google Play review / demo account (see docs/demo-account.md). Leave both
# empty to disable — no other phone number can ever use this fixed OTP.
# DEMO_ACCOUNT_PHONE must be an 8-digit local number, matching what the app
# itself sends (no country code prefix).
DEMO_ACCOUNT_PHONE=
DEMO_ACCOUNT_OTP=
DEMO_ACCOUNT_NAME="Google Play Reviewer"

# Public marketing site — phone/WhatsApp numbers shown in the footer, contact
# section, and the floating WhatsApp button (config/marketing.php).
MARKETING_CONTACT_PHONE=
MARKETING_CONTACT_WHATSAPP=
